# ─── Required ───────────────────────────────────────────────────────────────
# Postgres connection string (Neon, Supabase, Vercel Postgres, or any Postgres).
# On Vercel, adding a Neon database from the Storage tab sets this for you.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Optional ───────────────────────────────────────────────────────────────
# Secret used to sign login sessions. If you leave it out, one is generated
# and stored in the database on first run.
# AUTH_SECRET=

# Google sign-in. Leave both blank and the Google button simply does not appear.
# Create them at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Only needed if Google redirects back to the wrong address (custom domains
# behind a proxy). Set it to your site's public origin, with no trailing slash.
# AUTH_URL=https://tasks.teqnite.com

# Email delivery for invitations, through Resend (https://resend.com).
# Without it, invitations still work — the admin copies the link and sends it.
# RESEND_API_KEY=
# INVITE_FROM=Teqnite Tasks <tasks@yourdomain.com>
